rules_version = '2';

// Same hash-scoped model as firestore.rules: design and wishlist photos
// are compressed client-side and uploaded to photos/{hash}/..., where
// {hash} is the SHA-256 hex digest of the shared passcode. The regex
// just enforces the path shape; the real protection is that only a
// client holding the passcode can compute a matching hash. Default-deny
// everything else. Double-check this is actually the deployed ruleset
// in the Firebase console — it can't be verified from client code.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{hash}/{fileName} {
      allow read, write: if hash.matches('^[0-9a-f]{64}$');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
